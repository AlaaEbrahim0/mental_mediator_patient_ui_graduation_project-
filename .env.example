# Mental Mediator patient portal — environment template
# Copy to .env (gitignored). Variables must start with REACT_APP_.

# Backend API base URL (trailing slash is normalised in src/api/client.js).
REACT_APP_API_URL=https://nexus-api.runasp.net/

# Path to static images bundled with the app.
REACT_APP_IMAGE_BASE_URL=/images
